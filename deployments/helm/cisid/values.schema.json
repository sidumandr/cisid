{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "webhookSecret": {
          "type": "string"
        },
        "agentToken": {
          "type": "string"
        },
        "apiToken": {
          "type": "string"
        },
        "readToken": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "githubToken": {
          "type": "string"
        },
        "giteaToken": {
          "type": "string"
        },
        "giteaWebhookSecret": {
          "type": "string"
        },
        "forgejoToken": {
          "type": "string"
        },
        "forgejoWebhookSecret": {
          "type": "string"
        },
        "gitlabToken": {
          "type": "string"
        },
        "gitlabWebhookSecret": {
          "type": "string"
        },
        "bitbucketToken": {
          "type": "string"
        },
        "bitbucketWebhookSecret": {
          "type": "string"
        },
        "adminPassword": {
          "type": "string"
        },
        "smtpPassword": {
          "type": "string"
        },
        "oauthClientSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "github": {"type": "string"},
            "gitea": {"type": "string"},
            "forgejo": {"type": "string"},
            "gitlab": {"type": "string"},
            "bitbucket": {"type": "string"}
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^$|^postgres(ql)?://"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "publicURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "rateLimit": {
          "type": "number",
          "minimum": 0
        },
        "trustProxy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "buildForks": {
          "type": "boolean"
        },
        "githubAPIURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "giteaURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "forgejoURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "gitlabURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "readAccess": {
          "type": "string",
          "enum": ["", "public", "signed-in"]
        },
        "sessionTTL": {
          "type": "string",
          "pattern": "^([0-9]+d|([0-9]+([.][0-9]+)?(m|h))+)$"
        },
        "oauthClientIDs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "github": {"type": "string"},
            "gitea": {"type": "string"},
            "forgejo": {"type": "string"},
            "gitlab": {"type": "string"},
            "bitbucket": {"type": "string"}
          }
        },
        "oauthSignupRole": {
          "type": "string",
          "enum": ["", "viewer", "maintainer"]
        },
        "adminUser": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,38}$"
        },
        "pollInterval": {
          "type": "string",
          "pattern": "^(0|([0-9]+([.][0-9]+)?(ms|s|m|h))+)$"
        },
        "logRetention": {
          "type": "string",
          "pattern": "^(0|[0-9]+d|([0-9]+([.][0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
        },
        "publicBadges": {
          "type": "boolean"
        },
        "approveForks": {
          "type": "boolean"
        },
        "artifactMaxSize": {
          "type": "string",
          "pattern": "^[0-9]+ ?([KMG]B|B)?$"
        },
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 0, "maximum": 65535},
            "username": {"type": "string"},
            "from": {"type": "string"},
            "tls": {"type": "string", "enum": ["starttls", "tls", "none"]}
          }
        },
        "shutdownTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "serverURL": {
          "type": "string",
          "pattern": "^$|^wss?://"
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]{0,62}$"}
        },
        "stepMemory": {
          "type": [
            "string",
            "number"
          ]
        },
        "stepCPUs": {
          "type": [
            "string",
            "number"
          ]
        },
        "stepPids": {
          "type": "integer",
          "minimum": 0
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "dind",
                "hostSocket"
              ]
            },
            "dind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "repository"
                  ],
                  "properties": {
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tag": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "pullPolicy": {
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  }
                },
                "resources": {
                  "type": "object"
                },
                "persistence": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "size": {
                      "type": "string"
                    },
                    "storageClass": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "hostSocket": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "password": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "pattern": "^$|^https?://"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "authorize": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
