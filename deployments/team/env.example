# Copy to .env next to compose.yaml, fill it in, and keep it out of git:
#   cp deployments/team/env.example deployments/team/.env
#   chmod 600 deployments/team/.env
# What each setting does: docs/team-server.md and docs/server.md.

# The name teammates open in the browser, inside the company network.
CISID_HOST=ci.company.internal
CISID_PUBLIC_URL=https://ci.company.internal

# No name in DNS yet? Open it by the server's address meanwhile: list the
# address in CISID_HOST too, put it in CISID_PUBLIC_URL and the OAuth apps'
# callback URLs, and name it here (browsers send no name for an address).
# CISID_HOST=ci.company.internal, 203.0.113.7
# CISID_PUBLIC_URL=https://203.0.113.7
# CISID_DEFAULT_SNI=203.0.113.7

# Only these addresses reach cisid, separated by spaces (an address or a
# range, such as the office's public address or 10.0.0.0/8); everyone else
# gets 403. Empty lets everyone in.
# CISID_ALLOW_FROM=203.0.113.7 10.8.0.0/16

# If another proxy already holds ports 80 and 443 on the server: HTTPS on
# another port (then CISID_PUBLIC_URL carries it, https://ci...:9443), and
# plain HTTP kept on the server itself.
# CISID_PROXY_HTTPS_PORT=9443
# CISID_PROXY_HTTP_PORT=127.0.0.1:8089

# Generate each of these with: openssl rand -hex 32
CISID_DB_PASSWORD=
CISID_AGENT_TOKEN=
CISID_API_TOKEN=

# Seals repository secrets and teammates' forge tokens. Generate it with
# openssl rand -base64 32, and keep a copy apart from the database backups:
# without it, neither can be read again.
CISID_SECRET_KEY=

# Anyone who reaches the server may open an account, as a maintainer who
# connects repositories and runs builds; "Continue with GitHub" too. Only
# safe because the server is reachable only inside the company network.
CISID_SIGNUP_ROLE=maintainer
CISID_OAUTH_SIGNUP_ROLE=maintainer

# The forges cannot send webhooks into the network, so cisid asks them for
# new commits this often.
CISID_POLL_INTERVAL=1m

# GitHub OAuth app (Settings, Developer settings, OAuth Apps), with the
# callback URL https://ci.company.internal/auth/github/callback
CISID_GITHUB_OAUTH_CLIENT_ID=
CISID_GITHUB_OAUTH_CLIENT_SECRET=

# GitLab application (User settings, Applications), confidential, with the
# scopes api and read_user and the callback URL
# https://ci.company.internal/auth/gitlab/callback
CISID_GITLAB_OAUTH_CLIENT_ID=
CISID_GITLAB_OAUTH_CLIENT_SECRET=
# On the company's own GitLab:
# CISID_GITLAB_URL=https://gitlab.company.internal

# Limits of each build container on the agent.
CISID_STEP_MEMORY=4g
CISID_STEP_CPUS=2
